from typing import Any, final

__all__: list[str]
__version__: str

def render(size: Any, grid: Any, panels: Any, options: Any) -> bytes: ...
def colormaps() -> dict[str, bytes]: ...
def cmap_name(name: str) -> str: ...
def register_colormap(name: str, colors: bytes) -> None: ...
def render_pdf_pages(svgs: Any, dpis: Any) -> bytes: ...
def auto_ticks(lo: float, hi: float, log: bool = False, base: float = 10.0,
               target: int = 8) -> list[float]: ...
def tick_target(pixels: float, pixels_per_label: float) -> int: ...
def symlog(values: Any, linthresh: float, base: float, linscale: float) -> Any: ...
def symlog_inverse(values: Any, linthresh: float, base: float, linscale: float) -> Any: ...
def logit(values: Any) -> Any: ...
def logit_inverse(values: Any) -> Any: ...
def asinh(values: Any, linear_width: float) -> Any: ...
def asinh_inverse(values: Any, linear_width: float) -> Any: ...

# Rust classes cannot be subclassed and take their constructor arguments in
# `__new__`.
@final
class Colormap:
    name: str
    N: int
    def __new__(cls, name: str) -> Colormap: ...
    @property
    def colors(self) -> list[tuple[float, float, float]]: ...
    def __call__(self, value: Any, alpha: Any = None, bytes: bool = False) -> Any: ...
    def reversed(self, name: str | None = None) -> Colormap: ...
    def resampled(self, lut: int) -> Colormap: ...
    def with_extremes(self, bad: Any = None, under: Any = None,
                      over: Any = None) -> Colormap: ...
    def with_alpha(self, alpha: float | None) -> Colormap: ...
    def copy(self) -> Colormap: ...
    def set_bad(self, color: str = "k", alpha: float | None = None) -> None: ...
    def set_under(self, color: str = "k", alpha: float | None = None) -> None: ...
    def set_over(self, color: str = "k", alpha: float | None = None) -> None: ...

# The Rust normalization classes are independent types at runtime (none of them
# inherits another), so the stubs mirror that instead of inventing a hierarchy.
@final
class Normalize:
    vmin: float | None
    vmax: float | None
    clip: bool
    def __new__(cls, vmin: Any = None, vmax: Any = None,
                clip: bool = False) -> Normalize: ...
    def __call__(self, value: Any, clip: bool | None = None) -> Any: ...
    def autoscale(self, _values: Any) -> None: ...
    def autoscale_None(self, _values: Any) -> None: ...
    def inverse(self, value: Any) -> Any: ...

@final
class LogNorm:
    base: float | None
    vmin: float | None
    vmax: float | None
    clip: bool
    def __new__(cls, vmin: Any = None, vmax: Any = None, clip: bool = False,
                base: float = 10.0) -> LogNorm: ...
    def __call__(self, value: Any, clip: bool | None = None) -> Any: ...

@final
class PowerNorm:
    gamma: float
    vmin: float | None
    vmax: float | None
    clip: bool
    def __new__(cls, gamma: float, vmin: Any = None, vmax: Any = None,
                clip: bool = False) -> PowerNorm: ...
    def __call__(self, value: Any, clip: bool | None = None) -> Any: ...

@final
class SymLogNorm:
    linthresh: float
    linscale: float
    base: float | None
    vmin: float | None
    vmax: float | None
    clip: bool
    def __new__(cls, linthresh: float, linscale: float = 1.0, vmin: Any = None,
                vmax: Any = None, clip: bool = False, *,
                base: float = 10.0) -> SymLogNorm: ...
    def __call__(self, value: Any, clip: bool | None = None) -> Any: ...

@final
class AsinhNorm:
    linear_width: float
    vmin: float | None
    vmax: float | None
    clip: bool
    def __new__(cls, linear_width: float = 1.0, vmin: Any = None,
                vmax: Any = None, clip: bool = False) -> AsinhNorm: ...
    def __call__(self, value: Any, clip: bool | None = None) -> Any: ...

@final
class TwoSlopeNorm:
    vcenter: float
    vmin: float | None
    vmax: float | None
    clip: bool
    def __new__(cls, vcenter: float, vmin: Any = None, vmax: Any = None,
                clip: bool = False) -> TwoSlopeNorm: ...
    def __call__(self, value: Any, clip: bool | None = None) -> Any: ...

@final
class BoundaryNorm:
    boundaries: Any
    ncolors: int
    extend: str | None
    vmin: float | None
    vmax: float | None
    clip: bool
    def __new__(cls, boundaries: Any, ncolors: int, clip: bool = False,
                extend: str | None = None) -> BoundaryNorm: ...
    def __call__(self, value: Any, clip: bool | None = None) -> Any: ...
